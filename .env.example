# Copy to OpenMontage/.env and fill in ONE video provider key.
# Seedance 2.0 via fal.ai (recommended; also unlocks images + music in OpenMontage)
FAL_KEY=
# Alternatives OpenMontage also supports:
# ATLASCLOUD_API_KEY=   # Seedance 2.5 / Gemini Omni / MiniMax
# REPLICATE_API_TOKEN=  # Seedance via Replicate
# KLING_API_KEY=        # Kling
